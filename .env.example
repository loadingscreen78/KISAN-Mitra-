# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override. Google retires model names over time (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here_optional
HF_TOKEN=your_huggingface_token_here
# Optional trained Keras model, used instead of HuggingFace (default: backend/models/plantvillage_mobilenetv2.h5)
# PLANT_MODEL_PATH=backend/models/plantvillage_mobilenetv2.h5

# Weather API
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
VITE_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Optional Services
REPLICATE_API_TOKEN=your_replicate_token_optional

# Server Configuration
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000


# Firebase Authentication
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
