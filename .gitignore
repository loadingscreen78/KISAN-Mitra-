# ============================================
# Kisan Mitra - Professional .gitignore
# ============================================

# Environment Variables & Secrets
# ============================================
.env
.env.*
!.env.example
*.key
*.pem

# Model weights (large, and can be downloaded or trained)
*.h5
*.keras
backend/models/
secrets.json
config.local.js

# Dependencies
# ============================================
node_modules/
jspm_packages/
bower_components/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg
*.egg
*.egg-info/
.eggs/
venv/
env/
ENV/
.venv

# Build Outputs
# ============================================
dist/
dist-ssr/
build/
out/
*.local

# IDE & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.metadata/

# Operating System
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Testing & Coverage
# ============================================
coverage/
*.coverage
.nyc_output
.pytest_cache/
.tox/
.hypothesis/
htmlcov/
.coverage.*
nosetests.xml
coverage.xml
*.cover

# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.swp
*.swo
.cache/
.temp/
tmp/

# Mobile Development
# ============================================
android/
ios/
.capacitor/
*.apk
*.ipa

# Database
# ============================================
*.sqlite
*.sqlite3
*.db
*.db-journal

# Misc
# ============================================
.sass-cache/
connect.lock
typings/
*.tsbuildinfo

# Documentation Build
# ============================================
_site/
.jekyll-cache/
.jekyll-metadata

# Package Manager Locks (keep package-lock.json for npm)
# ============================================
# Uncomment if using yarn:
# yarn.lock
